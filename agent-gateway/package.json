    "status": "node dist/server.js status",
    "models": "node dist/server.js models",
    "doctor": "node dist/server.js doctor"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
