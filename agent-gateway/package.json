{
  "name": "agent-gateway",
  "version": "0.1.2",
  "private": true,
  "description": "Claude Code & Claude Desktop 聚合网关插件（支持 WorkBuddy、反重力与直连代理）",
  "type": "module",
  "bin": {
    "agent-gateway": "bin/agent-gateway.mjs"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node --experimental-transform-types --test tests/*.test.ts",
